[Unit]
Description=smelt MCP server (SSE)
After=network.target

[Service]
Type=simple
User=sid
WorkingDirectory=/home/sid/smelt
ExecStart=/home/sid/smelt/.venv/bin/python /home/sid/smelt/server.py --transport sse --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5
Environment=HOME=/home/sid

[Install]
WantedBy=multi-user.target
